# Configuracao do backup Jarvis — copie para scripts\.env.backup e preencha
# Este arquivo e versionado. O .env.backup com credenciais reais NAO eh versionado.

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@suaempresa.com.br
SMTP_PASS=sua_senha_smtp
SMTP_FROM=Jarvis <noreply@suaempresa.com.br>
NOTIFY_TO=destinatario@suaempresa.com.br

# Passphrase pro backup criptografado de .env + kong.yml (AES-256-CBC + PBKDF2).
# Gere com: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
# CRITICO: guarde uma copia FORA deste servidor (gerenciador de senhas) — se o
# servidor inteiro se perder, este arquivo some junto e a passphrase e a unica
# forma de decifrar o backup de segredos.
SECRETS_BACKUP_PASSPHRASE=
